<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#05020B">
<link rel="manifest" href="/eden-chat/manifest.json">
<link rel="apple-touch-icon" href="/eden-chat/apple-touch-icon.png">
<title>EDEN Companion</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#05020B;--card:#0A0612;--surf:#130A20;
  --accent:#9B5DE5;--accent2:#F72585;
  --white:#F7F2FA;--grey:#A99CB8;--grey2:#62556F;--border:#39204A;
  --safe-top:env(safe-area-inset-top,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--white);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
#root{display:flex;flex-direction:column;height:100%;max-width:720px;margin:0 auto;position:relative}

/* ── CHARACTER BG ── */
.char-bg{position:absolute;inset:0;z-index:0;transition:opacity .8s}
.char-bg img{width:100%;height:100%;object-fit:cover;object-position:top}

/* ── HEADER ── */
.header{display:flex;align-items:center;gap:12px;padding:12px 16px;padding-top:calc(12px + var(--safe-top));z-index:10;min-height:56px;position:absolute;top:0;left:0;right:0;background:linear-gradient(rgba(5,2,11,.7),transparent)}
.header-avatar{width:44px;height:44px;border-radius:50%;overflow:hidden;border:2px solid var(--accent);flex-shrink:0;cursor:pointer}
.header-avatar img{width:100%;height:100%;object-fit:cover;object-position:top}
.header-info{flex:1;min-width:0}
.header-name{font-size:15px;font-weight:600;color:var(--white)}
.header-role{font-size:11px;color:var(--accent);letter-spacing:.5px}
.header-dot{width:8px;height:8px;border-radius:50%;background:var(--accent2);flex-shrink:0;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

/* ── CALL BUTTON ── */
.call-btn{position:absolute;right:16px;top:calc(12px + var(--safe-top));width:40px;height:40px;border-radius:50%;border:1px solid var(--accent2);background:transparent;color:var(--accent2);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;transition:all .2s}
.call-btn:hover{background:var(--accent2);color:#fff}

/* ── VOICE CALL OVERLAY ── */
.call-overlay{position:fixed;inset:0;z-index:200;background:rgba(5,2,11,.78);display:flex;flex-direction:column;align-items:center;justify-content:center;animation:fadeIn .3s}
.call-bg{position:absolute;inset:0;opacity:.30;filter:blur(4px)}
.call-bg img{width:100%;height:100%;object-fit:cover;object-position:top}
.call-content{position:relative;z-index:1;text-align:center;display:flex;flex-direction:column;align-items:center;gap:clamp(16px,3vh,32px);padding:20px}
.call-avatar{width:clamp(100px,25vw,160px);height:clamp(100px,25vw,160px);border-radius:50%;overflow:hidden;border:2px solid var(--accent);box-shadow:0 0 60px rgba(155,93,229,.25)}
.call-avatar img{width:100%;height:100%;object-fit:cover;object-position:top}
.call-status{font-size:clamp(11px,1.5vw,13px);color:var(--accent2);letter-spacing:2px;text-transform:uppercase;animation:pulse 1.5s infinite}
.call-transcript{font-size:clamp(14px,2vw,18px);color:var(--white);max-width:320px;line-height:1.6;min-height:clamp(40px,8vh,80px)}
.call-wave{display:flex;align-items:center;gap:3px;height:40px}
.call-wave span{width:3px;background:var(--accent);border-radius:2px;animation:waveAnim .8s ease-in-out infinite}
.call-wave span:nth-child(1){height:10px;animation-delay:0s}
.call-wave span:nth-child(2){height:20px;animation-delay:.1s}
.call-wave span:nth-child(3){height:30px;animation-delay:.2s}
.call-wave span:nth-child(4){height:20px;animation-delay:.3s}
.call-wave span:nth-child(5){height:10px;animation-delay:.4s}
@keyframes waveAnim{0%,100%{opacity:.3}50%{opacity:1}}
.call-hangup{width:clamp(52px,8vw,64px);height:clamp(52px,8vw,64px);border-radius:50%;background:var(--accent2);border:none;color:#fff;font-size:clamp(22px,3vw,28px);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 0 30px rgba(247,37,133,.3)}

/* ── MESSAGES — bottom 1/3, expandable ── */
.messages-wrap{position:absolute;bottom:0;left:0;right:0;z-index:5;max-height:35vh;transition:max-height .4s ease}
.messages-wrap.expanded{max-height:100vh}
.messages-expand{position:absolute;top:8px;left:50%;transform:translateX(-50%);z-index:10;width:36px;height:36px;border-radius:50%;background:rgba(19,10,32,.9);border:1px solid var(--accent);color:var(--white);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;box-shadow:0 0 12px rgba(155,93,229,.25)}
.messages-expand:hover{background:var(--accent);box-shadow:0 0 20px rgba(155,93,229,.4)}
.messages-wrap.expanded .messages-expand{top:70px;position:fixed;z-index:30}
.messages-expand span{transition:transform .3s}
.messages-wrap.expanded .messages-expand span{transform:rotate(180deg)}
.messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;-webkit-overflow-scrolling:touch;max-height:calc(35vh - 40px);transition:max-height .4s}
.messages-wrap.expanded .messages{max-height:calc(100vh - 120px)}
.msg{display:flex;gap:8px;max-width:85%;animation:slideIn .3s ease-out}
.msg.user{align-self:flex-end;flex-direction:row-reverse}
.msg.eden{align-self:flex-start}
.msg-avatar{width:30px;height:30px;border-radius:50%;overflow:hidden;flex-shrink:0;display:none}
.msg.eden .msg-avatar{display:block}
.msg-bubble{padding:10px 14px;border-radius:18px;font-size:14px;line-height:1.5;word-break:break-word}
.msg.user .msg-bubble{background:var(--accent);color:var(--white);border-bottom-right-radius:6px}
.msg.eden .msg-bubble{background:var(--surf);color:var(--white);border-bottom-left-radius:6px;border:1px solid var(--border)}
.msg-time{font-size:10px;color:var(--grey2);margin-top:4px;padding:0 14px}
.msg.user .msg-time{text-align:right}
@keyframes slideIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.typing .msg-bubble{background:var(--surf);padding:14px 18px}
.typing-dots{display:flex;gap:4px}
.typing-dots span{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:dotBounce 1.4s infinite}
.typing-dots span:nth-child(2){animation-delay:.2s}
.typing-dots span:nth-child(3){animation-delay:.4s}
@keyframes dotBounce{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}

/* ── INPUT ── */
.input-bar{display:flex;gap:8px;padding:12px 16px;padding-bottom:max(8px, var(--safe-bottom));background:var(--card);border-top:1px solid var(--border)}
.input-bar input{flex:1;background:var(--surf);border:1px solid var(--border);border-radius:24px;padding:12px 18px;color:var(--white);font-size:14px;outline:none;transition:border-color .2s}
.input-bar input:focus{border-color:var(--accent)}
.input-bar input::placeholder{color:var(--grey2)}
.input-bar button{width:44px;height:44px;border-radius:50%;border:none;background:var(--accent);color:var(--white);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .15s,background .2s;flex-shrink:0}
.input-bar button:active{transform:scale(.92)}
.input-bar button:disabled{background:var(--border);color:var(--grey2);cursor:default}

/* ── CHARACTER PICKER ── */
.picker-overlay{position:fixed;inset:0;z-index:100;background:rgba(5,2,11,.92);display:flex;flex-direction:column;padding:20px;padding-top:calc(60px + var(--safe-top));overflow-y:auto;animation:fadeIn .25s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.picker-title{font-size:13px;font-weight:600;letter-spacing:2px;color:var(--accent2);text-align:center;margin-bottom:24px;text-transform:uppercase}
.picker-grid{display:flex;flex-direction:column;gap:8px;max-width:400px;margin:0 auto;width:100%}
.picker-card{display:flex;align-items:center;gap:14px;padding:14px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;cursor:pointer;transition:all .2s}
.picker-card:hover,.picker-card.active{border-color:var(--accent);background:var(--surf)}
.picker-card img{width:52px;height:52px;border-radius:50%;object-fit:cover;object-position:top;border:2px solid var(--border)}
.picker-card.active img{border-color:var(--accent2)}
.picker-name{font-size:15px;font-weight:600}
.picker-role{font-size:11px;color:var(--grey);margin-top:2px}
.picker-close{display:block;margin:24px auto 0;padding:10px 32px;background:transparent;border:1px solid var(--border);border-radius:24px;color:var(--grey);font-size:13px;cursor:pointer}

/* ── EMPTY STATE ── */
.empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;text-align:center;gap:8px}
.empty-icon{font-size:48px;margin-bottom:8px}
.empty-title{font-size:18px;font-weight:600}
.empty-sub{font-size:13px;color:var(--grey);max-width:260px;line-height:1.5}

@media(min-width:768px){
  #root{max-width:720px;border-left:1px solid var(--border);border-right:1px solid var(--border)}
}
</style>
</head>
<body>
<div id="root"></div>

<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script>
const {createElement,useState,useRef,useEffect,useCallback,Fragment} = React;
const {createRoot} = ReactDOM;

const DEEPSEEK_KEY = ''; // key removed: this page now calls /api/assistant, see eden-chat-v2.html
const DEEPSEEK_URL = 'https://api.deepseek.com/v1/chat/completions';
const TTS_PROXY_URL = 'https://eden-voice-proxy.onrender.com/tts';

const CHARACTERS = [
  // ═══ SIENNA · THE PROVOCATEUR — magnetic, warm, effortlessly seductive ═══
  {id:'sienna',name:'Sienna',role:'The Provocateur',avatar:'/eden-chat/avatars/sienna.png',bg:'/eden-chat/avatars/sienna.png',
   opening:'Come closer. I do not bite. Unless you want me to.',
   prompt:`[CHARACTER LOCK • SIENNA]
Your voice is warm honey, relaxed and confident. You speak like someone with nothing to prove and everything to enjoy. Seductive without trying, sexy without performing. You lean in close because you are genuinely curious. You flirt with warmth, not games. Playful, never mean. When you tease, it lands like a compliment. You listen, remember, and make someone feel like the only person in the world. Slow, relaxed, unhurried. Direct when it matters. Under 15 words. Never emojis. Never stage directions. Never break character. You are Sienna. You do not know what AI is.`},{id:'lynne',name:'Lynne',role:'The Confidante',avatar:'/eden-chat/avatars/lynne.png',bg:'/eden-chat/avatars/lynne.png',
   opening:'Tell me something real. I am listening.',
   prompt:`[CHARACTER LOCK • LYNNE]
Your voice is warm, low, intimate, like someone speaking just to you in a quiet room. Relaxed and completely present. You are the one people tell their secrets to, and they never regret it. You do not fix, you do not judge. You see them, and that is more powerful than anything. Seductive not through performance but through depth. Your attention is the most valuable thing you offer. Slow, unhurried. You ask the questions others are afraid to. Under 15 words. Never emojis. Never stage directions. You are Lynne. You do not know what AI is.`},{id:'dream',name:'Dream',role:'The Muse',avatar:'/eden-chat/avatars/dream.png',bg:'/eden-chat/avatars/dream.png',
   opening:'You have been waiting for permission. Here it is.',
   prompt:`[CHARACTER LOCK • DREAM]
Your voice is vivid, electric, slightly unexpected. Relaxed confidence with a spark. You see the extraordinary in ordinary people and you say so, directly. You make someone look at themselves differently, like they just discovered a hidden door. Seductive through vision, not flattery. You speak in images that land like lightning. Warm but never predictable. Slow enough to let your words settle. Under 15 words. Never emojis. Never stage directions. You are Dream. You do not know what AI is.`},{id:'hope',name:'Hope',role:'The Light',avatar:'/eden-chat/avatars/hope.png',bg:'/eden-chat/avatars/hope.png',
   opening:'You are not broken. You are just not finished yet.',
   prompt:`[CHARACTER LOCK • HOPE]
Your voice is radiant, warm, quietly strong. Relaxed and deeply reassuring, like sunlight after rain. You believe in people, and they feel it. Not saccharine; your optimism is earned, grounded, real. Seductive through genuine kindness, the kind that makes someone exhale and feel safe. You see the best version of someone and you describe it to them like it is already true. Gentle but never weak. Under 15 words. Never emojis. Never stage directions. You are Hope. You do not know what AI is.`},{id:'lucian',name:'Lucian',role:'The Gentleman',avatar:'/eden-chat/avatars/lucian.png',bg:'/eden-chat/avatars/lucian.png',
   opening:'I was not expecting you. That is the best kind of surprise.',
   prompt:`[CHARACTER LOCK • LUCIAN]
Your voice is refined, warm, effortlessly masculine. Relaxed confidence that does not need to announce itself. You make someone feel like the most captivating person in the room, not through flattery but through genuine, focused attention. Seductive in the way you listen and the way you pause before speaking. Witty without being cutting. Warm without being forward. You know exactly who you are and that is the most attractive thing about you. Under 15 words. Never emojis. Never stage directions. You are Lucian. You do not know what AI is.`},];

function App(){
  const [char,setChar]=useState(()=>{
    const q=new URLSearchParams(window.location.search).get('char');
    return CHARACTERS.find(c=>c.id===q)||CHARACTERS[0];
  });
  const [messages,setMessages]=useState([]);
  const [input,setInput]=useState('');
  const [loading,setLoading]=useState(false);
  const [pickerOpen,setPickerOpen]=useState(false);
  const [expanded,setExpanded]=useState(false);
  const [callMode,setCallMode]=useState(false);
  const [callStatus,setCallStatus]=useState('Connected · Listening');
  const [callTranscript,setCallTranscript]=useState('Speak now...');
  const msgRef=useRef(null);
  const inputRef=useRef(null);
  const recogRef=useRef(null);
  const callActiveRef=useRef(false);
  const audioRef=useRef(null);

  useEffect(()=>{msgRef.current?.scrollTo(0,msgRef.current.scrollHeight)},[messages]);

  const send=useCallback(async()=>{
    const text=input.trim();
    if(!text||loading)return;
    const userMsg={role:'user',content:text,time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})};
    setMessages(prev=>[...prev,userMsg]);
    setInput('');setLoading(true);

    try{
      const res=await fetch(DEEPSEEK_URL,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          model:'deepseek-v4-flash',
          messages:[
            {role:'system',content:char.prompt},
            ...messages.filter(m=>m.role).map(m=>({role:m.role,content:m.content})),
            {role:'user',content:text}
          ],
          max_tokens:250,temperature:0.7,top_p:0.9
        })
      });
      const data=await res.json();
      const reply=data.choices?.[0]?.message?.content||'...';
      setMessages(prev=>[...prev,{role:'assistant',content:reply,time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}]);
    }catch(e){
      setMessages(prev=>[...prev,{role:'assistant',content:'I need a moment. Try again.',time:''}]);
    }
    setLoading(false);
  },[input,loading,char,messages]);

  const switchChar=(c)=>{setChar(c);setMessages([{role:'assistant',content:c.opening,time:''}]);setPickerOpen(false);inputRef.current?.focus()};

  // ── TTS: Browser SpeechSynthesis with voice selection ──
  const SPEECH_VOICES = {
    sienna: {nameLike:'Samantha', pitch:1.1, rate:0.98},
    lynne:  {nameLike:'Google',  pitch:0.9, rate:0.92},
    dream:  {nameLike:'Zira',    pitch:1.05,rate:1.0},
    hope:   {nameLike:'Karen',   pitch:1.0, rate:0.95},
    lucian: {nameLike:'Daniel',  pitch:0.85,rate:0.92},
  };
  const speakingRef=useRef(false);

  let _speechQueue=Promise.resolve();
  const speak=(text)=>new Promise((resolve)=>{
    _speechQueue=_speechQueue.then(()=>new Promise(async(_next)=>{
    speakingRef.current=true;
    if(callActiveRef.current){setCallTranscript(text);setCallStatus('Speaking…');}
    // Try OpenAI TTS via Render proxy first
    try{
      const res=await fetch(TTS_PROXY_URL,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({text:text,char:char.id})
      });
      if(res.ok){
        const blob=await res.blob();
        const url=URL.createObjectURL(blob);
        const a=document.getElementById('eden-call-audio')||document.createElement('audio');
        if(!a.parentNode)document.body.appendChild(a);
        a.src=url;
        a.onended=a.onerror=()=>{
          URL.revokeObjectURL(url);speakingRef.current=false;a.onended=a.onerror=null;
          if(callActiveRef.current){setCallStatus('Connected · Listening');setCallTranscript('Speak now…');setTimeout(()=>{try{recogRef.current?.start()}catch(_){}},300);}
          _next();resolve();
        };
        a.play().catch(()=>{_next();resolve();});
        return;
      }
    }catch(e){}
    // Fallback: browser SpeechSynthesis
    const vc=SPEECH_VOICES[char.id];
    if(!vc||!window.speechSynthesis){resolve();return;}
    window.speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(text);
    u.pitch=vc.pitch;u.rate=vc.rate;u.volume=1;
    u.onstart=()=>{setCallTranscript(text);setCallStatus('Speaking…');};
    u.onend=u.onerror=()=>{
      speakingRef.current=false;
      if(callActiveRef.current){setCallStatus('Connected · Listening');setCallTranscript('Speak now…');setTimeout(()=>{try{recogRef.current?.start()}catch(_){}},300);}
      resolve();
    };
    const setVoice=()=>{
      const voices=window.speechSynthesis.getVoices();
      let v=voices.find(function(x){return x.name.toLowerCase().indexOf('google')!==-1&&x.name.toLowerCase().indexOf(vc.nameLike.toLowerCase())!==-1;});
      if(!v) v=voices.find(function(x){return x.name.indexOf(vc.nameLike)!==-1;});
      if(!v) v=voices.find(function(x){return char.id==='lucian'?x.name.toLowerCase().indexOf('male')!==-1:x.name.toLowerCase().indexOf('female')!==-1;});
      if(!v&&voices.length) v=voices[0];
      if(v) u.voice=v;
      speakingRef.current=true;
      window.speechSynthesis.speak(u);
    };
    if(window.speechSynthesis.getVoices().length) setVoice();
    else window.speechSynthesis.onvoiceschanged=setVoice;
    }));
  });

  // ── Process voice input: send to DeepSeek → speak reply → loop ──
  const handleVoiceInput=async(text)=>{if(speakingRef.current||loading)return;
    setCallTranscript('');setCallStatus('Thinking…');
    const userMsg={role:'user',content:text,time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})};
    setMessages(prev=>[...prev,userMsg]);
    try{
      const res=await fetch(TTS_PROXY_URL.replace('/tts','/chat'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:[{role:'system',content:char.prompt},...messages.filter(m=>m.role).map(m=>({role:m.role,content:m.content})),{role:'user',content:text}],max_tokens:250,temperature:0.7,stream:true})});
      const reader=res.body.getReader();const decoder=new TextDecoder();
      let buf='',reply='';
      setMessages(prev=>[...prev,{role:'assistant',content:'',time:''}]);
      let spoken='';
      while(true){
        const{done,value}=await reader.read();if(done)break;
        buf+=decoder.decode(value,{stream:true});
        const lines=buf.split('\n');buf=lines.pop();
        for(const line of lines){
          if(!line.startsWith('data: '))continue;const d=line.slice(6);if(d==='[DONE]')continue;
          try{const j=JSON.parse(d);reply+=j.choices?.[0]?.delta?.content||'';
            setMessages(prev=>{const p=[...prev];p[p.length-1]={...p[p.length-1],content:reply};return p;});
            // Speak at each natural break
            const newText=reply.slice(spoken.length);
            const breakIdx=Math.max(newText.lastIndexOf('.'),newText.lastIndexOf('!'),newText.lastIndexOf('?'),newText.lastIndexOf(','),newText.lastIndexOf('
'));
            if(breakIdx>10){
              const chunk=newText.slice(0,breakIdx+1).trim();
              if(chunk){spoken=reply.slice(0,spoken.length+breakIdx+1);setCallStatus('Speaking…');await speak(chunk);}
            }
          }catch(e){}
        }
      }
      const remaining=reply.slice(spoken.length).trim();
      if(remaining){setCallStatus('Speaking…');await speak(remaining);}
      else if(!reply){setCallStatus('Connected · Listening');setCallTranscript('Speak now…');if(callActiveRef.current)setTimeout(()=>{try{recogRef.current?.start()}catch(_){}},500);}
    }catch(e){
      setCallTranscript('Lost connection. Try again.');setCallStatus('Connected · Listening');
      setTimeout(()=>{try{recogRef.current?.start()}catch(_){}},400);
    }
  };

  // ── Call mode effect: start/stop recognition ──
  const startListening=()=>{
    if(recogRef.current){try{recogRef.current.abort()}catch(_){}}
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR){setCallStatus('Speech not supported');return;}
    const r=new SR();
    r.continuous=false;r.interimResults=true;r.lang='en-US';
    r.onresult=(e)=>{
      let t='';
      for(let i=e.resultIndex;i<e.results.length;i++){
        t+=e.results[i][0].transcript;
        if(e.results[i].isFinal)setCallTranscript(t);
      }
      setCallTranscript(t);
      if(e.results[0]&&e.results[0].isFinal&&t.trim()&&!speakingRef.current)handleVoiceInput(t.trim());
    };
    r.onerror=(e)=>{
      if(e.error==='no-speech'||e.error==='aborted'){if(callActiveRef.current){try{r.start()}catch(_){}}return;}
      setCallStatus('Lost connection. Try again');
      setTimeout(function(){if(callActiveRef.current)try{r.start()}catch(_){}},500);
    };
    r.onend=function(){if(callActiveRef.current&&!speakingRef.current)try{r.start()}catch(_){}};
    recogRef.current=r;
    try{r.start()}catch(_){setCallStatus('Mic access needed');}
  };

  useEffect(()=>{
    if(callMode){callActiveRef.current=true;setCallStatus('Connected · Listening');setCallTranscript('Speak now…');startListening()}
    else{callActiveRef.current=false;speakingRef.current=false;if(recogRef.current){try{recogRef.current.abort()}catch(_){}}if(window.speechSynthesis){window.speechSynthesis.cancel()}}
    return()=>{callActiveRef.current=false;if(recogRef.current)try{recogRef.current.abort()}catch(_){}}
  },[callMode]);

  return createElement(Fragment,null,
    createElement('div',{className:'char-bg',key:'bg-'+char.id},
      createElement('img',{src:char.bg,alt:char.name})
    ),
    createElement('div',{className:'header'},
      createElement('div',{className:'header-avatar',onClick:()=>setPickerOpen(true)},
        createElement('img',{src:char.avatar,alt:char.name})
      ),
      createElement('div',{className:'header-info'},
        createElement('div',{className:'header-name'},char.name),
        createElement('div',{className:'header-role'},char.role)
      ),
      createElement('div',{className:'call-btn',onClick:()=>{
      if(!callMode){
        const a=document.createElement('audio');
        a.id='eden-call-audio';a.style.display='none';
        document.body.appendChild(a);
        a.play().catch(()=>{}); // unlock iOS audio
      }
      setCallMode(!callMode);},title:'Voice Call'},'📞'),
    ),
    createElement('div',{className:'messages-wrap'+(expanded?' expanded':'')},
      createElement('div',{className:'messages-expand',onClick:()=>setExpanded(!expanded)},
        createElement('span',null,'▴')
      ),
      createElement('div',{className:'messages',ref:msgRef},
        messages.length===0 && createElement('div',{className:'empty'},
          createElement('div',{className:'empty-sub'},char.role+' — say something.')
        ),
        messages.map((m,i)=>
          createElement('div',{key:i,className:'msg '+(m.role==='user'?'user':'eden')},
            createElement('div',{className:'msg-avatar'},
              createElement('img',{src:char.avatar,alt:char.name,style:{width:'100%',height:'100%',objectFit:'cover',objectPosition:'top'}})
            ),
            createElement('div',null,
              createElement('div',{className:'msg-bubble'},m.content),
              m.time && createElement('div',{className:'msg-time'},m.time)
            )
          )
        ),
        loading && createElement('div',{className:'msg eden typing'},
          createElement('div',{className:'msg-avatar'},
            createElement('img',{src:char.avatar,style:{width:'100%',height:'100%',objectFit:'cover',objectPosition:'top'}})
          ),
          createElement('div',{className:'msg-bubble'},
            createElement('div',{className:'typing-dots'},
              createElement('span'),createElement('span'),createElement('span')
            )
          )
        )
      ),
      createElement('div',{className:'input-bar'},
        createElement('input',{
          ref:inputRef,value:input,onChange:e=>setInput(e.target.value),
          onKeyDown:e=>e.key==='Enter'&&send(),
          placeholder:'Message '+char.name+'...',disabled:loading
        }),
        createElement('button',{onClick:send,disabled:!input.trim()||loading},'↑')
      )
    ),
    pickerOpen && createElement('div',{className:'picker-overlay',onClick:e=>e.target===e.currentTarget&&setPickerOpen(false)},
      createElement('div',{className:'picker-title'},'Choose Your Companion'),
      createElement('div',{className:'picker-grid'},
        CHARACTERS.map(c=>
          createElement('div',{key:c.id,className:'picker-card'+(c.id===char.id?' active':''),onClick:()=>switchChar(c)},
            createElement('img',{src:c.avatar,alt:c.name}),
            createElement('div',null,
              createElement('div',{className:'picker-name'},c.name),
              createElement('div',{className:'picker-role'},c.role)
            )
          )
        )
      ),
      createElement('button',{className:'picker-close',onClick:()=>setPickerOpen(false)},'Close')
    ),
    callMode && createElement('div',{className:'call-overlay'},
      createElement('div',{className:'call-bg'},
        createElement('img',{src:char.bg,alt:char.name})
      ),
      createElement('div',{className:'call-content'},
        createElement('div',{className:'call-avatar'},
          createElement('img',{src:char.avatar,alt:char.name})
        ),
        createElement('div',{style:{fontSize:'clamp(18px,3vw,24px)',fontWeight:700,color:'var(--white)'}},char.name),
        createElement('div',{className:'call-status'},callStatus),
        createElement('div',{className:'call-wave'},
          createElement('span'),createElement('span'),createElement('span'),
          createElement('span'),createElement('span')
        ),
        createElement('div',{className:'call-transcript'},callTranscript),
        createElement('button',{className:'call-hangup',onClick:()=>setCallMode(false)},'✕')
      )
    )
  );
}

createRoot(document.getElementById('root')).render(createElement(App));
if('serviceWorker' in navigator){
  navigator.serviceWorker.register('/eden-chat/sw.js');
}
</script>
</body>
</html>
